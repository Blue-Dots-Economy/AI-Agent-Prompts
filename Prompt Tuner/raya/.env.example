# Raya Voice AI deploy credentials — copy this file to raya/.env and fill in.
# raya/.env is git-ignored; NEVER commit real values.

# Base URL of the Raya REST API (ask LitWiz Labs). Include any version prefix,
# e.g. https://api.getraya.app/v1  — no trailing slash.
RAYA_BASE_URL=

# API auth token (Bearer token or API key — the header/scheme is set in
# raya/endpoints.json under "auth"). Treat as a secret.
RAYA_API_TOKEN=

# Which environment RAYA_BASE_URL + RAYA_API_TOKEN point at: staging | prod
# The tool picks each target's raya_agent_id[<this value>] from raya/agents.json.
# Keep this on `staging` unless you are intentionally deploying to production.
RAYA_ENV=staging
